@{
    ViewData["Title"] = "Lotes de Inventario";
}

<h1>Lotes de Inventario</h1>

<p>
    <button class="btn btn-primary"
            hx-get="@Url.Action("Create")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        <i class="bi bi-plus-circle"></i> Registrar Lote (Compra)
    </button>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Proveedor</th>
            <th>Cant. Total</th>
            <th>Cant. Disponible</th>
            <th>Precio Compra</th>
            <th>Fecha Entrada</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="inventario-tbody"
           hx-get="@Url.Action("GetInventarioList")"
           hx-trigger="load, refreshInventarioList from:body"
           hx-swap="innerHTML">
           
           <tr><td colspan="8">Cargando inventario...</td></tr>
    </tbody>
</table>