@model ProyectoSistemaInventarioNuevo.Models.Inventario
@{ Layout = null; }

<div class="modal-header">
    <h5 class="modal-title">Detalles del Lote</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4">Producto</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProductoNavigation.Nombre)</dd>
        
        <dt class="col-sm-4">Proveedor</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.IdProveedorNavigation.Nombre)</dd>

        <dt class="col-sm-4">Cantidad Total</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

        <dt class="col-sm-4">Cantidad Disponible</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.CantidadDisponible)</dd>
        
        <dt class="col-sm-4">Precio Compra</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioCompra)</dd>
        
        <dt class="col-sm-4">Fecha Entrada</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaEntrada)</dd>

        <dt class="col-sm-4">Fecha Salida</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.FechaSalida)</dd>
        
        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>