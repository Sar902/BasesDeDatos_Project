@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.Inventario>

@foreach (var item in Model) {
    <tr>
        <td>@Html.DisplayFor(modelItem => item.IdProductoNavigation.Nombre)</td>
        <td>@Html.DisplayFor(modelItem => item.IdProveedorNavigation.Nombre)</td>
        <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
        <td>@Html.DisplayFor(modelItem => item.CantidadDisponible)</td>
        <td>@Html.DisplayFor(modelItem => item.PrecioCompra)</td>
        <td>@Html.DisplayFor(modelItem => item.FechaEntrada)</td>
        <td>@Html.DisplayFor(modelItem => item.Estado)</td>
        <td>
            <button class="btn btn-primary btn-sm"
               hx-get="@Url.Action("Edit", new { id = item.IdInventario })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Edit
            </button> |
            <button class="btn btn-info btn-sm"
               hx-get="@Url.Action("Details", new { id = item.IdInventario })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Details
            </button> |
            <button class="btn btn-danger btn-sm"
               hx-get="@Url.Action("Delete", new { id = item.IdInventario })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Delete
            </button>
        </td>
    </tr>
}