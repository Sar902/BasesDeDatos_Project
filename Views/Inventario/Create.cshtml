@model ProyectoSistemaInventarioNuevo.ViewModels.CompraViewModel

@{
    ViewData["Title"] = "Registrar Compra de Inventario";
    // NOTA: Al quitar 'Layout = null', usará automáticamente _Layout.cshtml
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <form asp-action="Create" id="form-crear-compra">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Fecha" class="control-label"></label>
                    <input asp-for="Fecha" class="form-control" type="date" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr />

        <div class="card bg-light mb-3">
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-3">
                        <label class="control-label">Producto</label>
                        <select id="select-producto" asp-items="ViewBag.Productos" class="form-control">
                            <option value="">-- Seleccione Producto --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="control-label">Proveedor</label>
                        <select id="select-proveedor" asp-items="ViewBag.Proveedores" class="form-control">
                            <option value="">-- Seleccione Proveedor --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="control-label">Cantidad</label>
                        <input id="input-cantidad" type="number" value="1" min="1" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="control-label">Costo Unit.</label>
                        <input id="input-precio" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btn-agregar-item" class="btn btn-primary w-100">
                            <i class="bi bi-plus"></i> Agregar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <h3>Lotes a Ingresar</h3>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Producto</th>
                    <th>Proveedor</th>
                    <th>Cantidad</th>
                    <th>Costo Unit.</th>
                    <th>Subtotal</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody id="carrito-items">
            </tbody>
        </table>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <h3 class="text-end">Total Compra: <span id="display-total">0.00</span></h3>
                <input type="hidden" asp-for="TotalCompra" id="hidden-total" />
            </div>
        </div>

        <div id="hidden-items-container"></div>

        <div class="form-group mt-4">
            <input type="submit" value="Guardar Todo" class="btn btn-success btn-lg" />
            <a asp-action="Index" class="btn btn-secondary btn-lg">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // 1. Agregar al carrito
            $('#btn-agregar-item').click(function () {
                var productoId = $('#select-producto').val();
                var nombreProducto = $('#select-producto option:selected').text();
                var proveedorId = $('#select-proveedor').val();
                var nombreProveedor = $('#select-proveedor option:selected').text();
                var cantidad = parseInt($('#input-cantidad').val());
                var precioVal = $('#input-precio').val().replace(',', '.');
                var precio = parseFloat(precioVal);

                if (!productoId) { alert('Seleccione un producto.'); return; }
                if (!proveedorId) { alert('Seleccione un proveedor.'); return; }
                if (isNaN(cantidad) || cantidad <= 0) { alert('Cantidad inválida.'); return; }
                if (isNaN(precio) || precio < 0) { alert('Precio inválido.'); return; }

                var subtotal = cantidad * precio;
                var precioDisplay = precio.toLocaleString('es-NI', { minimumFractionDigits: 2 });
                var subtotalDisplay = subtotal.toLocaleString('es-NI', { minimumFractionDigits: 2 });

                var fila = `
                    <tr data-product-id="${productoId}" 
                        data-proveedor-id="${proveedorId}"
                        data-cantidad="${cantidad}" 
                        data-precio="${precio}" 
                        data-subtotal="${subtotal}"
                        data-nombre-prod="${nombreProducto}"
                        data-nombre-prov="${nombreProveedor}">
                        <td>${nombreProducto}</td>
                        <td>${nombreProveedor}</td>
                        <td>${cantidad}</td>
                        <td>${precioDisplay}</td>
                        <td>${subtotalDisplay}</td>
                        <td><button type="button" class="btn btn-danger btn-sm btn-remover-item"><i class="bi bi-trash"></i></button></td>
                    </tr>`;

                $('#carrito-items').append(fila);
                actualizarTotal();
                
                // Limpiar campos (opcional: no limpiamos proveedor por si sigues comprando al mismo)
                $('#input-cantidad').val(1);
                $('#input-precio').val('');
                $('#select-producto').val('').focus();
            });

            // 2. Quitar del carrito
            $('#carrito-items').on('click', '.btn-remover-item', function () {
                $(this).closest('tr').remove();
                actualizarTotal();
            });

            // 3. Submit del formulario
            $('#form-crear-compra').submit(function (e) {
                $('#hidden-items-container').empty();
                var index = 0;

                $('#carrito-items tr').each(function () {
                    var fila = $(this);
                    var precioStr = fila.data('precio').toString().replace('.', ',');
                    var subtotalStr = fila.data('subtotal').toString().replace('.', ',');

                    var inputs = `
                        <input type="hidden" name="Items[${index}].IdProducto" value="${fila.data('product-id')}" />
                        <input type="hidden" name="Items[${index}].IdProveedor" value="${fila.data('proveedor-id')}" />
                        <input type="hidden" name="Items[${index}].Cantidad" value="${fila.data('cantidad')}" />
                        <input type="hidden" name="Items[${index}].PrecioCompra" value="${precioStr}" />
                        <input type="hidden" name="Items[${index}].Subtotal" value="${subtotalStr}" />
                        <input type="hidden" name="Items[${index}].NombreProducto" value="${fila.data('nombre-prod')}" />
                        <input type="hidden" name="Items[${index}].NombreProveedor" value="${fila.data('nombre-prov')}" />
                    `;
                    $('#hidden-items-container').append(inputs);
                    index++;
                });

                if (index === 0) {
                    alert('Debe agregar al menos un lote a la lista.');
                    e.preventDefault();
                    return false;
                }
                return true;
            });

            function actualizarTotal() {
                var total = 0;
                $('#carrito-items tr').each(function () {
                    total += parseFloat($(this).data('subtotal'));
                });
                $('#display-total').text(total.toLocaleString('es-NI', { minimumFractionDigits: 2 }));
                $('#hidden-total').val(total.toString().replace('.', ','));
            }
        });
    </script>
}