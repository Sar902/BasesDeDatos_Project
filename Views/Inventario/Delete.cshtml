@model ProyectoSistemaInventarioNuevo.Models.Inventario
@{ Layout = null; } 

<div class="modal-header">
    <h5 class="modal-title">Confirmar Eliminación</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Delete"
      hx-post="@Url.Action("Delete", new { id = Model.IdInventario })"
      hx-target="this" 
      hx-swap="outerHTML">
    
    @Html.AntiForgeryToken()
    
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdInventario" />
        
        <p>¿Está seguro de que desea eliminar este lote?</p>
        
        <div class="alert alert-warning">
            <strong>Producto:</strong> @Model.IdProductoNavigation.Nombre <br/>
            <strong>Proveedor:</strong> @Model.IdProveedorNavigation.Nombre <br/>
            <strong>Fecha:</strong> @Model.FechaEntrada.ToShortDateString() <br/>
            <strong>Cantidad Total Lote:</strong> @Model.Cantidad <br/>
            <strong class="text-danger">Cantidad Disponible:</strong> @Model.CantidadDisponible
        </div>
        
        <p class="text-danger fw-bold">
            ADVERTENCIA: Esta acción eliminará el lote y recalculará el stock maestro del producto.
            (Efectivamente, se restará @Model.CantidadDisponible del stock total).
        </p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger">Eliminar Lote</button>
    </div>
</form>