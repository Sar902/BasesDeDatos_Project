@model ProyectoSistemaInventarioNuevo.Models.Inventario

@{
    ViewData["Title"] = "Eliminar Lote";
    // Al quitar Layout = null, se carga el diseño general
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">¿Está seguro de que desea eliminar este lote de inventario?</h5>

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle"></i> 
                        Esta acción es irreversible y <strong>restará el stock disponible</strong> de este lote del inventario general.
                    </div>

                    <dl class="row mt-4">
                        <dt class="col-sm-4 text-end">Producto:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.IdProductoNavigation?.Nombre</dd>

                        <dt class="col-sm-4 text-end">Proveedor:</dt>
                        <dd class="col-sm-8">@Model.IdProveedorNavigation?.Nombre</dd>

                        <dt class="col-sm-4 text-end">Fecha de Entrada:</dt>
                        <dd class="col-sm-8">@Model.FechaEntrada.ToShortDateString()</dd>

                        <dt class="col-sm-4 text-end">Costo Unitario:</dt>
                        <dd class="col-sm-8">C$ @Model.PrecioCompra.ToString("N2")</dd>

                        <dt class="col-sm-4 text-end">Cantidad Original:</dt>
                        <dd class="col-sm-8">@Model.Cantidad</dd>

                        <dt class="col-sm-4 text-end text-danger">Cantidad a Restar:</dt>
                        <dd class="col-sm-8 text-danger fw-bold">@Model.CantidadDisponible (Disponible actualmente)</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" class="text-center">
                        <input type="hidden" asp-for="IdInventario" />
                        
                        <a asp-action="Index" class="btn btn-secondary me-2">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Confirmar y Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>