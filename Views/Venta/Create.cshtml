@model ProyectoSistemaInventarioNuevo.ViewModels.VentaViewModel

@{
    ViewData["Title"] = "Crear Nueva Venta";
}

<h1>@ViewData["Title"]</h1>

<h4>Venta</h4>
<hr />
<div class="row">
    <form asp-action="Create" id="form-crear-venta">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label asp-for="Fecha" class="control-label"></label>
                    <input asp-for="Fecha" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
            </div>
        </div>

        <hr />

        <div class="row align-items-end">
            <div class="col-md-4">
                <label class="control-label">Producto</label>
                <select id="select-producto" asp-items="ViewBag.Productos" class="form-control">
                    <option value="">-- Seleccione un producto --</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="control-label">Stock Disp.</label>
                <input id="input-stock" type="text" class="form-control" readonly style="background-color: #e9ecef; font-weight: bold;" />
            </div>

            <div class="col-md-2">
                <label class="control-label">Cantidad</label>
                <input id="input-cantidad" type="number" value="1" min="1" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="control-label">Precio Unit.</label>
                <input id="input-precio" type="text" class="form-control" readonly />
            </div>
            <div class="col-md-2">
                <button type="button" id="btn-agregar-item" class="btn btn-primary">Agregar al Carrito</button>
            </div>
        </div>

        <hr />

        <h3>Detalle de Venta</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unit.</th>
                    <th>Subtotal</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody id="carrito-items">
            </tbody>
        </table>

        <div class="row justify-content-end">
            <div class="col-md-4">
                <h3 class="text-end">Total: <span id="display-total">0.00</span></h3>
                <input type="hidden" asp-for="Total" id="hidden-total" />
            </div>
        </div>
        
        <div id="hidden-items-container"></div>


        <div class="form-group mt-3">
            <input type="submit" value="Guardar Venta" class="btn btn-success" />
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {

            var itemsEnCarrito = []; 

            // ==========================================
            // PUNTO 2 y 4: Lógica de Producto y Stock
            // ==========================================

            // Al seleccionar producto
            $('#select-producto').change(function () {
                var productoId = $(this).val();
                
                if (productoId) {
                    $.get('/Venta/GetProductoDetails', { id: productoId }, function (data) {
                        // 1. Precio
                        $('#input-precio').val(data.precioVenta.toFixed(2).replace('.', ','));
                        
                        // 2. Stock Visual (PUNTO 4)
                        var stock = data.stockActual;
                        $('#input-stock').val(stock);

                        // Lógica de colores y bloqueo
                        $('#input-stock').removeClass('bg-warning text-dark bg-danger text-white bg-light');
                        $('#btn-agregar-item').prop('disabled', false);

                        if (stock <= 0) {
                            $('#input-stock').addClass('bg-danger text-white'); // Rojo si es 0
                            $('#btn-agregar-item').prop('disabled', true);      // Bloquear botón
                            alert('¡Atención! Este producto no tiene stock disponible.');
                        } 
                        else if (stock <= 5) {
                            $('#input-stock').addClass('bg-warning text-dark'); // Amarillo si es bajo
                        } 
                        else {
                            $('#input-stock').addClass('bg-light'); // Normal
                        }

                        // Ajustar máximo del input
                        $('#input-cantidad').attr('max', stock);
                        $('#input-cantidad').val(1);
                        $('#input-cantidad').focus(); // Mover cursor a cantidad automáticamente

                    }).fail(function() {
                        alert('Error al obtener los detalles del producto.');
                    });
                } else {
                    limpiarCamposProducto();
                }
            });

            // PUNTO 2: Agregar con tecla ENTER en el campo cantidad
            $('#input-cantidad').keypress(function (e) {
                if (e.which == 13) { // Código 13 es Enter
                    e.preventDefault(); // Evitar submit del form principal
                    $('#btn-agregar-item').click(); // Disparar el click del botón agregar
                }
            });

            // Botón Agregar al Carrito
            $('#btn-agregar-item').click(function () {
                var productoId = $('#select-producto').val();
                var cantidad = parseInt($('#input-cantidad').val());
                var precio = parseFloat($('#input-precio').val().replace(',', '.'));
                var nombre = $('#select-producto option:selected').text();
                var stockDisponible = parseInt($('#input-stock').val());

                // Validaciones
                if (!productoId) { alert('Debe seleccionar un producto.'); return; }
                if (isNaN(cantidad) || cantidad <= 0) { alert('Cantidad inválida.'); return; }
                
                // Validación Stock (PUNTO 4 - Frontend)
                if (!isNaN(stockDisponible) && cantidad > stockDisponible) {
                    alert('No puedes vender ' + cantidad + '. Solo hay ' + stockDisponible + ' en stock.');
                    return;
                }

                if (itemsEnCarrito.includes(productoId)) {
                    alert('Este producto ya está en el carrito.'); return;
                }

                var subtotal = cantidad * precio;
                
                // Crear fila HTML
                var fila = `
                    <tr data-product-id="${productoId}" 
                        data-cantidad="${cantidad}" 
                        data-precio="${precio}" 
                        data-subtotal="${subtotal}"
                        data-nombre="${nombre}">
                        <td>${nombre}</td>
                        <td>${cantidad}</td>
                        <td>${precio.toLocaleString('es-NI', { minimumFractionDigits: 2 })}</td>
                        <td>${subtotal.toLocaleString('es-NI', { minimumFractionDigits: 2 })}</td>
                        <td><button type="button" class="btn btn-danger btn-sm btn-remover-item"><i class="bi bi-trash"></i></button></td>
                    </tr>`;
                
                $('#carrito-items').append(fila);
                itemsEnCarrito.push(productoId);
                
                actualizarTotal();
                limpiarCamposProducto(); // Esto ahora re-enfocará el buscador (PUNTO 2)
            });

            // Remover item
            $('#carrito-items').on('click', '.btn-remover-item', function () {
                var fila = $(this).closest('tr');
                var productoId = fila.data('product-id').toString();
                itemsEnCarrito = itemsEnCarrito.filter(id => id !== productoId);
                fila.remove();
                actualizarTotal();
            });

            // Submit del formulario
            $('#form-crear-venta').submit(function (e) {
                $('#hidden-items-container').empty();
                var index = 0;

                $('#carrito-items tr').each(function () {
                    var fila = $(this);
                    var precioStr = fila.data('precio').toString().replace('.', ','); 
                    
                    // Generar inputs ocultos para el backend
                    $('#hidden-items-container').append(`<input type="hidden" name="Items[${index}].IdProducto" value="${fila.data('product-id')}" />`);
                    $('#hidden-items-container').append(`<input type="hidden" name="Items[${index}].Cantidad" value="${fila.data('cantidad')}" />`);
                    $('#hidden-items-container').append(`<input type="hidden" name="Items[${index}].PrecioVentaUnitario" value="${precioStr}" />`);
                    // El subtotal y nombre no son estrictamente necesarios para el bind del modelo, pero ayudan si hay errores de validación
                    index++;
                });

                if (index === 0) {
                    alert('El carrito está vacío.');
                    e.preventDefault();
                    return false;
                }
                return true;
            });

            // Funciones Auxiliares
            function actualizarTotal() {
                var total = 0;
                $('#carrito-items tr').each(function () {
                    total += parseFloat($(this).data('subtotal'));
                });
                $('#display-total').text(total.toLocaleString('es-NI', { minimumFractionDigits: 2 }));
                $('#hidden-total').val(total.toString().replace('.', ','));
                
                // Si tienes la función calcularCambio() del consejo anterior, llámala aquí:
                // if (typeof calcularCambio === "function") calcularCambio();
            }

            function limpiarCamposProducto() {
                $('#select-producto').val(''); // Reset select
                $('#input-stock').val('').removeClass('bg-warning bg-danger text-white').addClass('bg-light'); // Reset stock visual
                $('#input-cantidad').val(1);
                $('#input-precio').val('');
                $('#btn-agregar-item').prop('disabled', false); // Reactivar botón por si acaso
                
                // PUNTO 2: Re-enfocar el buscador para seguir vendiendo rápido
                $('#select-producto').focus(); 
            }
        });
    </script>
}