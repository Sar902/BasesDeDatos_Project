@model ProyectoSistemaInventarioNuevo.Models.VVentum
@{ Layout = null; } 

<div class="modal-header">
    <h5 class="modal-title">Confirmar Eliminación</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Delete"
      hx-post="@Url.Action("Delete", new { id = Model.IdVenta })"
      hx-target="this" 
      hx-swap="outerHTML">
    
    @Html.AntiForgeryToken()
    
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdVenta" />
        
        <p>¿Está seguro de que desea eliminar la Venta #<strong>@Model.IdVenta</strong> del <strong>@Model.Fecha.ToShortDateString()</strong>?</p>
        <p class="text-danger fw-bold">
            ADVERTENCIA: Esta acción es peligrosa y solo se permite si la venta no tiene detalles.
            La lógica correcta sería ANULAR la venta y REVERTIR el stock.
        </p>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger">Eliminar</button>
    </div>
</form>