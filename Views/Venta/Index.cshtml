@{
    ViewData["Title"] = "Historial de Ventas";
}

<h1>Historial de Ventas</h1>

<div class="card mb-4 shadow-sm bg-light">
    <div class="card-body py-3">
        <form asp-action="GetVentaList" 
              method="get" 
              class="row g-3 align-items-end"
              hx-get="@Url.Action("GetVentaList")" 
              hx-target="#venta-tbody"
              hx-trigger="submit, change from:input[type='date']"
              hx-indicator="#loading">
            
            <div class="col-md-2">
                <a class="btn btn-success w-100" asp-action="Create">
                    <i class="bi bi-cart-plus"></i> Nueva Venta
                </a>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold small">Desde</label>
                <input type="date" name="fechaInicio" class="form-control" 
                       value="@DateTime.Today.ToString("yyyy-MM-01")" /> </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small">Hasta</label>
                <input type="date" name="fechaFin" class="form-control" 
                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-bold small">N° Recibo / ID</label>
                <input type="number" name="idVenta" class="form-control" placeholder="Ej: 105" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>N° Venta</th>
            <th>Fecha</th>
            <th class="text-end">Total</th>
            <th class="text-end text-success">Ganancia</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody id="venta-tbody"
           hx-get="@Url.Action("GetVentaList")"
           hx-trigger="load"
           hx-swap="innerHTML">
           
           <tr><td colspan="5" class="text-center py-3">Cargando historial...</td></tr>
    </tbody>
</table>

<div id="loading" class="htmx-indicator text-center mt-2">
    <div class="spinner-border text-primary spinner-border-sm" role="status"></div>
    <span class="text-muted ms-2">Actualizando...</span>
</div>