@{
    ViewData["Title"] = "Ventas";
}

<h1>Listado de Ventas</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-circle"></i> Registrar Nueva Venta
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID Venta</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Ganancia Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="venta-tbody"
           hx-get="@Url.Action("GetVentaList")"
           hx-trigger="load, refreshVentaList from:body"
           hx-swap="innerHTML">
           
           <tr><td colspan="5">Cargando ventas...</td></tr>
    </tbody>
</table>