@model ProyectoSistemaInventarioNuevo.ViewModels.VentaDetailsViewModel

@{
    ViewData["Title"] = "Detalles de la Venta";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Venta Nro: @Model.Venta!.IdVenta</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Venta!.Fecha)
        </dd>
        <dt class = "col-sm-2">
            Total
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Venta!.Total)
        </dd>
        </dl>
</div>

<hr />

<h4>Productos Vendidos</h4>
<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
            <th>Ganancia Subtotal</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Detalles) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreProducto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadVendida)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecioVentaUnitario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Subtotal)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GananciaSubtotal)
            </td>
        </tr>
}
    </tbody>
</table>

<br />
<div>
    <a asp-action="Edit" asp-route-id="@Model.Venta!.IdVenta" class="btn btn-primary">Editar</a> 
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</div>