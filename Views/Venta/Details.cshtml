@model ProyectoSistemaInventarioNuevo.ViewModels.VentaDetailsViewModel
@{ Layout = null; } 

<div class="modal-header">
    <h5 class="modal-title">Detalles de Venta #@Model.Venta.IdVenta</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    
    <h4>Resumen de Venta</h4>
    <dl class="row">
        <dt class="col-sm-4">Fecha</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Venta.Fecha)</dd>
        
        <dt class="col-sm-4">Total Venta</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Venta.Total)</dd>

        <dt class="col-sm-4">Ganancia Total</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Venta.GananciaTotal)</dd>
    </dl>
    
    <hr />
    
    <h4>Productos Vendidos</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Detalles)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NombreProducto)</td>
                    <td>@Html.DisplayFor(modelItem => item.CantidadVendida)</td>
                    <td>@Html.DisplayFor(modelItem => item.PrecioVentaUnitario)</td>
                    <td>@Html.DisplayFor(modelItem => item.Subtotal)</td>
                </tr>
            }
        </tbody>
    </table>

</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>