@model ProyectoSistemaInventarioNuevo.ViewModels.SoliDetailsViewModel
@{ Layout = null; } 

<div class="modal-header">
    <h5 class="modal-title">Detalles de Solicitud de devoluciones #@Model.Soli.IdSolicitudDevolucion</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    
    <h4>Resumen de Devolucion</h4>
    <dl class="row">
        <dt class="col-sm-4">Fecha</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Soli.Fecha)</dd>
        
        <dt class="col-sm-4">Proveedor</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Soli.Proveedor)</dd>

        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Soli.Estado)</dd>
    </dl>
    
    <hr />
    
    <h4>Productos Solicitados</h4>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Compr.</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Detalles)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NombreProducto)</td>
                    <td>@Html.DisplayFor(modelItem => item.CantidadSolicitada)</td>
                    <td>@Html.DisplayFor(modelItem => item.PrecioCompraUnitario)</td>
                </tr>
            }
        </tbody>
    </table>

</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
