@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.SolicitudDevolucion>

@{
    ViewData["Title"] = "Solicitudes de devolucion";
}

<h1>Listado de solicitudes de devolucion</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-circle"></i> Registrar Nueva Solicitud de devolucion
    </a>
</p>


<table class="table">
    <thead>
        <tr>
            <th>Nº De Solicitud de devolucion</th>
            <th>Proveedor</th>
            <th>Observaciones</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody id="solicitud-tbody"
        hx-get="@Url.Action("GetSolicitudesList")"
        hx-trigger="load, refreshSolicitudesList from:body"
        hx-swap="innerHTML">
        <tr><td colspan="6">Cargando solicitudes...</td></tr>
    </tbody>

</table>