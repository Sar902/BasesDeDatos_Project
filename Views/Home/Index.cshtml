@{
    ViewData["Title"] = "Panel Principal";
}

<div class="d-flex" id="wrapper">

    <!-- Sidebar -->
    <div class="bg-light border-end" id="sidebar-wrapper">
        <div class="sidebar-heading text-center py-4 fw-bold fs-4 border-bottom">
            Panel Principal
        </div>
        <div class="list-group list-group-flush">
            <a asp-controller="Producto" asp-action="Index" class="list-group-item list-group-item-action">Productos</a>
            <a asp-controller="Categoria" asp-action="Index" class="list-group-item list-group-item-action">Categorías</a>
            <a asp-controller="Inventario" asp-action="Index" class="list-group-item list-group-item-action">Inventario</a>
            <a asp-controller="Perdida" asp-action="Index" class="list-group-item list-group-item-action">Pérdidas</a>
            <a asp-controller="DetallePerdida" asp-action="Index" class="list-group-item list-group-item-action">Detalle Pérdidas</a>
            <a asp-controller="Venta" asp-action="Index" class="list-group-item list-group-item-action">Ventas</a>
            <a asp-controller="DetalleVenta" asp-action="Index" class="list-group-item list-group-item-action">Detalle Ventas</a>
            <a asp-controller="Proveedor" asp-action="Index" class="list-group-item list-group-item-action">Proveedores</a>
            <a asp-controller="SolicitudDevolucion" asp-action="Index" class="list-group-item list-group-item-action">Solicitud Devolución</a>
            <a asp-controller="DetalleSolicitudDevolucion" asp-action="Index" class="list-group-item list-group-item-action">Detalle Solicitud Devolución</a>
           <a asp-controller="VVentum" asp-action="Index" class="list-group-item list-group-item-action">Vista venta</a>
         <a asp-controller="VDetalleVentum" asp-action="Index" class="list-group-item list-group-item-action">Vista detalle venta</a>
         <a asp-controller="VProducto" asp-action="Index" class="list-group-item list-group-item-action">Vista producto</a>
        <a asp-controller="VDetallePerdidum" asp-action="Index" class="list-group-item list-group-item-action">Vista detalle perdida</a>
        
        
        
        
        
        </div>
    </div>

    <!-- Page Content -->
    <div id="page-content-wrapper" class="p-4 flex-fill">
        <h2 class="text-center mb-4">Bienvenido al Panel Principal</h2>
        <p class="text-center text-muted">Selecciona una opción del menú lateral para comenzar.</p>
    </div>
</div>
