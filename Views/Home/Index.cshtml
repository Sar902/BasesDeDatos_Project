@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card dashboard-box text-center p-3 h-100 shadow-sm">
            <i class="bi bi-box-seam display-4 mb-2 text-primary"></i>
            <h6 class="text-muted">Total Productos</h6>
            <p class="fw-bold fs-4 mb-0">@ViewBag.TotalProductos</p>
        </div>
    </div>
    
    <div class="col-sm-6 col-md-3">
        <div class="card dashboard-box text-center p-3 h-100 shadow-sm">
            <i class="bi bi-currency-dollar display-4 mb-2 text-success"></i>
            <h6 class="text-muted">Total Ventas</h6>
            <p class="fw-bold fs-4 mb-0">$@ViewBag.TotalVentas</p>
        </div>
    </div>
    
    <div class="col-sm-6 col-md-3">
        <div class="card dashboard-box text-center p-3 h-100 shadow-sm">
            <i class="bi bi-exclamation-triangle display-4 mb-2 text-danger"></i>
            <h6 class="text-muted">Pérdidas del mes</h6>
            <p class="fw-bold fs-4 mb-0">@ViewBag.PerdidasMes</p>
        </div>
    </div>
    
    <div class="col-sm-6 col-md-3">
        <div class="card dashboard-box text-center p-3 h-100 shadow-sm">
            <i class="bi bi-people display-4 mb-2 text-info"></i>
            <h6 class="text-muted">Proveedores Activos</h6>
            <p class="fw-bold fs-4 mb-0">@ViewBag.ProveedoresActivosCount</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4"> 
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 text-secondary"><i class="bi bi-graph-down-arrow me-2"></i>Productos con inventario bajo</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive"> 
            <table class="table table-hover align-middle mb-0"> 
                <thead class="table-light"> 
                    <tr> 
                        <th class="ps-4">Producto</th> 
                        <th>Stock disponible</th> 
                    </tr> 
                </thead>
                <tbody> 
                    @if (ViewBag.InventarioBajo != null)
                    {
                        foreach (var item in ViewBag.InventarioBajo)
                        { 
                            <tr class="@((item.CantidadDisponible < 5) ? "table-danger" : "")"> 
                                <td class="ps-4 fw-bold">@item.IdProductoNavigation.Nombre</td> 
                                <td>@item.CantidadDisponible</td> 
                            </tr> 
                        }
                    }
                </tbody>
            </table>
        </div> 
    </div>
</div>