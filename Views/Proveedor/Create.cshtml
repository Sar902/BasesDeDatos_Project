@model ProyectoSistemaInventarioNuevo.Models.Proveedor
@{ 
    Layout = null; 
}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="bi bi-person-plus-fill me-2"></i>Registrar Nuevo Proveedor
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create"
      hx-post="@Url.Action("Create")"
      hx-target="#modal-content-generic"
      hx-swap="innerHTML">
      
    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <div class="form-floating">
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Distribuidora La Universal" autocomplete="off" />
                    <label asp-for="Nombre">Nombre de la Empresa / Proveedor</label>
                </div>
                <span asp-validation-for="Nombre" class="text-danger small ms-1"></span>
            </div>

            <div class="col-12">
                <div class="form-floating">
                    <input asp-for="Contacto" class="form-control" placeholder="Ej: 8888-8888" />
                    <label asp-for="Contacto">Teléfono o Contacto Directo</label>
                </div>
                <span asp-validation-for="Contacto" class="text-danger small ms-1"></span>
                <div class="form-text ms-1 text-muted">
                    <i class="bi bi-info-circle"></i> Ingrese un número de celular, convencional o correo.
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> Cancelar
        </button>
        <button type="submit" class="btn btn-success px-4">
            <i class="bi bi-check-circle"></i> Guardar Proveedor
        </button>
    </div>
</form>

@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }