@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.Proveedor>

@if (!Model.Any())
{
    <tr>
        <td colspan="4" class="text-center py-5">
            <div class="text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <span>No se encontraron proveedores con estos filtros.</span>
            </div>
        </td>
    </tr>
}
else
{
    foreach (var item in Model)
    {
        <tr>
            <td class="ps-4 fw-bold text-dark">
                @item.Nombre
            </td>

            <td>
                @if (!string.IsNullOrEmpty(item.Contacto))
                {
                    <span class="text-muted"><i class="bi bi-telephone me-1"></i>@item.Contacto</span>
                }
                else
                {
                    <span class="text-muted fst-italic small">-- Sin contacto --</span>
                }
            </td>

            <td>
                @if (item.Estado == "Activo")
                {
                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill border border-success">
                        <i class="bi bi-check-circle-fill me-1"></i>Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill border border-secondary">
                        <i class="bi bi-archive-fill me-1"></i>Inactivo
                    </span>
                }
            </td>

            <td class="text-end pe-4">
                <div class="btn-group" role="group">
                    <button class="btn btn-sm btn-light border text-primary"
                            hx-get="@Url.Action("Details", new { id = item.IdProveedor })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML"
                            title="Ver Historial y Detalles">
                        <i class="bi bi-eye"></i>
                    </button>

                    <button class="btn btn-sm btn-light border text-warning"
                            hx-get="@Url.Action("Edit", new { id = item.IdProveedor })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML"
                            title="Editar Datos">
                        <i class="bi bi-pencil"></i>
                    </button>

                    <button class="btn btn-sm btn-light border text-danger"
                            hx-get="@Url.Action("Delete", new { id = item.IdProveedor })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML"
                            title="Eliminar Proveedor">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
}