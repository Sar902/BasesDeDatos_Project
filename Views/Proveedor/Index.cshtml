@{
    ViewData["Title"] = "Proveedores";
}

<h1>Proveedores</h1>

<h4 class="mb-3">
    Proveedores Activos: 
    <span class="badge bg-success"
          hx-get="@Url.Action("GetProveedorCount")"
          hx-trigger="load, refreshProveedorList from:body"
          hx-swap="innerHTML">
        ...
    </span>
</h4>

<p>
    <button class="btn btn-primary"
            hx-get="@Url.Action("Create")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        <i class="bi bi-plus-circle"></i> Crear Nuevo Proveedor
    </button>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Contacto</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="proveedor-tbody"
           hx-get="@Url.Action("GetProveedorList")"
           hx-trigger="load, refreshProveedorList from:body"
           hx-swap="innerHTML">
           
           <tr><td colspan="4">Cargando proveedores...</td></tr>
    </tbody>
</table>