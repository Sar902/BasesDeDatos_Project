@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.Categorium>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PorcentajeGanancia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Estado)
        </td>
        <td>
            <button class="btn btn-primary btn-sm"
               hx-get="@Url.Action("Edit", new { id = item.IdCategoria })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Edit
            </button> |

            <button class="btn btn-info btn-sm"
               hx-get="@Url.Action("Details", new { id = item.IdCategoria })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Details
            </button> |
            
            <button class="btn btn-danger btn-sm"
               hx-get="@Url.Action("Delete", new { id = item.IdCategoria })"
               hx-target="#modal-content-generic"
               hx-swap="innerHTML">
                Delete
            </button>
        </td>
    </tr>
}