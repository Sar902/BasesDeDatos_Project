@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.Categorium>

@if (!Model.Any())
{
    <tr>
        <td colspan="4" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No se encontraron categorías.
        </td>
    </tr>
}
else
{
    foreach (var item in Model)
    {
        <tr>
            <td class="ps-4 fw-bold text-dark">@item.Nombre</td>
            
            <td class="text-center">
                <span class="badge bg-info text-dark bg-opacity-10 border border-info rounded-pill px-3">
                    @item.PorcentajeGanancia%
                </span>
            </td>

            <td>
                @if (item.Estado == "Activo")
                {
                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill border border-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill border border-secondary">Inactivo</span>
                }
            </td>

            <td class="text-end pe-4">
                <div class="btn-group">
                    <button class="btn btn-sm btn-light border text-primary"
                            hx-get="@Url.Action("Details", new { id = item.IdCategoria })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML" title="Ver Detalles">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-light border text-warning"
                            hx-get="@Url.Action("Edit", new { id = item.IdCategoria })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-light border text-danger"
                            hx-get="@Url.Action("Delete", new { id = item.IdCategoria })"
                            hx-target="#modal-content-generic"
                            hx-swap="innerHTML" title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
}