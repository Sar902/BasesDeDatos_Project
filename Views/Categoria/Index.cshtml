@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<p>
    <!-- 
      Este botón ahora usa HTMX para cargar el formulario "Create"
      dentro del contenedor del modal genérico que definimos en _Layout.
    -->
    <button class="btn btn-primary"
            hx-get="@Url.Action("Create")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        <i class="bi bi-plus-circle"></i> Crear Nueva
    </button>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>% Ganancia</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <!--
      Este <tbody> se cargará inicialmente Y se refrescará
      cada vez que escuche el evento "refreshCategoriaList"
      que disparamos desde el controlador.
    -->
    <tbody id="categoria-tbody"
           hx-get="@Url.Action("GetCategoriaList")"
           hx-trigger="load, refreshCategoriaList from:body"
           hx-swap="innerHTML">
           
           <!-- Aquí se mostrará un indicador de carga -->
           <tr><td colspan="4">Cargando...</td></tr>
    </tbody>
</table>