@model ProyectoSistemaInventarioNuevo.Models.Categorium
@{ Layout = null; } <!-- Parcial -->

<div class="modal-header">
    <h5 class="modal-title">Detalles de Categoría</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>
        
        <dt class_ = "col-sm-4">@Html.DisplayNameFor(model => model.PorcentajeGanancia)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.PorcentajeGanancia)</dd>
        
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Estado)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>