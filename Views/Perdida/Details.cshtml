@model ProyectoSistemaInventarioNuevo.ViewModels.PerdidaCreateViewModel
@{ Layout = null; }
@using System.Globalization  

@{
    // Define la cultura de Nicaragua (Córdoba)
    var niCulture = new CultureInfo("es-NI");
}

<div class="modal-header">
    <h5 class="modal-title">Detalles de Pérdida del @Model.Fecha.ToShortDateString()</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <h4>Motivo: @Model.Motivo</h4>
    
    <h5>Total: @Model.Total.ToString("C", niCulture)</h5>
    <hr />

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad Perdida</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.NombreProducto</td>
                    <td>@item.CantidadPerdida</td>
                    
                    <td>@item.PrecioCompraUnitario.ToString("C", niCulture)</td> 
                    
                    <td>@item.SubtotalPerdida.ToString("C", niCulture)</td> 
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>