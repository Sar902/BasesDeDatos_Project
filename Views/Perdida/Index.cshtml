
@{
    ViewData["Title"] = "Pérdidas";
}

<h1>Listado de Pérdidas</h1>

<p>

    <button type="button" class="btn btn-primary"
        onclick="location.href='@Url.Action("Create")'">
    <i class="bi bi-plus-circle"></i> Crear nueva pérdida
</button>

</p>

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Total</th>
            <th>Motivo</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="perdida-tbody"
           hx-get="@Url.Action("GetPerdidaList")"
           hx-trigger="load, refreshPerdidaList from:body"
           hx-swap="innerHTML">
        <tr><td colspan="4">Cargando...</td></tr>
    </tbody>
</table>