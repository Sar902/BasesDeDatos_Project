@model ProyectoSistemaInventarioNuevo.Models.Perdidum
@{ Layout = null; }

<div class="modal-header">
    <h5 class="modal-title">Confirmar Eliminación</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form asp-action="DeleteConfirmed"
      hx-post="@Url.Action("DeleteConfirmed", new { id = Model.IdPerdida })"
      hx-target="#perdida-@Model.IdPerdida"
      hx-swap="outerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-body">
        <p>¿Está seguro de que desea eliminar la pérdida del <strong>@Model.Fecha.ToShortDateString()</strong> con motivo "<strong>@Model.Motivo</strong>"?</p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger">Eliminar</button>
    </div>
</form>
