@model ProyectoSistemaInventarioNuevo.ViewModels.PerdidaEditViewModel
@{ Layout = null; }

<div class="modal-header">
    <h5 class="modal-title">Editar Pérdida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<form method="post"
      hx-post="@Url.Action("Edit", new { id = Model.IdPerdida })"
      hx-target="#perdida-@Model.IdPerdida"
      hx-swap="outerHTML">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPerdida" />

    <div class="modal-body">

        <!-- Fecha -->
        <div class="mb-3">
            <label asp-for="Fecha" class="form-label"></label>
            <input asp-for="Fecha" type="date" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>

        <!-- Motivo -->
        <div class="mb-3">
            <label asp-for="Motivo" class="form-label"></label>
            <input asp-for="Motivo" class="form-control" />
            <span asp-validation-for="Motivo" class="text-danger"></span>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
