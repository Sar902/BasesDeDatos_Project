@model IEnumerable<ProyectoSistemaInventarioWeb.Models.DetallePerdidum>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CantidadPerdida)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioCompraUnitario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdPerdidaNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdProductoNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadPerdida)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecioCompraUnitario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdPerdidaNavigation.IdPerdida)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdProductoNavigation.IdProducto)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdDetallePerdida">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdDetallePerdida">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdDetallePerdida">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
