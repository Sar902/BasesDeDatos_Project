@{
    ViewData["Title"] = "Productos";
}

<h1>Gestión de Productos</h1>

<p>
    <button class="btn btn-primary"
            hx-get="@Url.Action("Create")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        <i class="bi bi-plus-circle"></i> Crear nuevo producto
    </button>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio Venta</th>
            <th>Stock (Cantidad)</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="producto-tbody"
           hx-get="@Url.Action("GetProductoList")"
           hx-trigger="load, refreshProductoList from:body"
           hx-swap="innerHTML">
           
           <tr><td colspan="6">Cargando productos...</td></tr>
    </tbody>
</table>