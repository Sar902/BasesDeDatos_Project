@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="mb-4">
    <h1 class="fw-bold text-dark"><i class="bi bi-box-seam-fill text-success me-2"></i>Productos</h1>
    <p class="text-muted mb-0">Inventario general y precios de venta.</p>
</div>

<div class="card mb-4 shadow-sm border-0 bg-light">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            
            <div class="col-md-2">
                <button class="btn btn-primary w-100 shadow-sm"
                        hx-get="@Url.Action("Create")"
                        hx-target="#modal-content-generic"
                        hx-swap="innerHTML">
                    <i class="bi bi-plus-lg"></i> Nuevo
                </button>
            </div>

            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted mb-1">Buscar</label>
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0 filter-input" 
                           name="searchString" 
                           placeholder="Nombre del producto..."
                           hx-get="@Url.Action("GetProductoList")" 
                           hx-target="#producto-tbody"
                           hx-trigger="keyup changed delay:500ms" 
                           hx-include=".filter-input"
                           autocomplete="off">
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Ordenar por</label>
                <select class="form-select shadow-sm filter-input" 
                        name="sortOrder"
                        hx-get="@Url.Action("GetProductoList")" 
                        hx-target="#producto-tbody"
                        hx-trigger="change" 
                        hx-include=".filter-input">
                    <option value="">Nombre (A-Z)</option>
                    <option value="precio_desc">Precio (Mayor a Menor)</option>
                    <option value="precio_asc">Precio (Menor a Mayor)</option>
                    <option value="stock_asc">Stock (Menor a Mayor)</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Estado</label>
                <select class="form-select shadow-sm filter-input" 
                        name="statusFilter"
                        hx-get="@Url.Action("GetProductoList")" 
                        hx-target="#producto-tbody"
                        hx-trigger="change" 
                        hx-include=".filter-input">
                    <option value="Activo" selected>Activos</option>
                    <option value="Inactivo">Inactivos</option>
                    <option value="Todos">Todos</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase text-secondary small fw-bold">Producto</th>
                        <th class="text-uppercase text-secondary small fw-bold">Categoría</th>
                        <th class="text-end text-uppercase text-secondary small fw-bold">Precio Venta</th>
                        <th class="text-center text-uppercase text-secondary small fw-bold">Stock</th>
                        <th class="text-uppercase text-secondary small fw-bold">Estado</th>
                        <th class="text-end pe-4 text-uppercase text-secondary small fw-bold">Acciones</th>
                    </tr>
                </thead>
                <tbody id="producto-tbody"
                       hx-get="@Url.Action("GetProductoList")"
                       hx-trigger="load, refreshProductoList from:body"
                       hx-include=".filter-input"
                       hx-swap="innerHTML">
                       
                       <tr><td colspan="6" class="text-center py-5">Cargando productos...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>