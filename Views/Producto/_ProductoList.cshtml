@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.VProducto>

@if (!Model.Any())
{
    <tr>
        <td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No se encontraron productos con estos filtros.
        </td>
    </tr>
}
else
{
    foreach (var item in Model)
    {
        <tr>
            <td class="ps-4 fw-bold text-dark">@item.Nombre</td>
            
            <td class="text-muted small">
                <i class="bi bi-tag me-1"></i>
                @(ViewData["CategoriasMap"] is Dictionary<int, string> map && map.ContainsKey(item.IdCategoria) ? map[item.IdCategoria] : "General")
            </td>

            <td class="text-end fw-bold text-primary font-monospace">
                C$ @(item.PrecioVenta?.ToString("N2") ?? "0.00")
            </td>

            <td class="text-center">
                @if (item.Cantidad <= 5)
                {
                    <span class="badge bg-danger bg-opacity-75 rounded-pill px-3" title="Stock Bajo">
                        @item.Cantidad
                    </span>
                }
                else
                {
                    <span class="badge bg-light text-dark border rounded-pill px-3">
                        @item.Cantidad
                    </span>
                }
            </td>

            <td>
                @if (item.Estado == "Activo")
                {
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill border border-success px-2">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill border border-secondary px-2">Inactivo</span>
                }
            </td>

            <td class="text-end pe-4">
                <div class="btn-group">
                    <button class="btn btn-sm btn-light border text-primary"
                            hx-get="@Url.Action("Details", new { id = item.IdProducto })"
                            hx-target="#modal-content-generic" 
                            hx-swap="innerHTML" 
                            title="Ver Detalles">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-light border text-warning"
                            hx-get="@Url.Action("Edit", new { id = item.IdProducto })"
                            hx-target="#modal-content-generic" 
                            hx-swap="innerHTML" 
                            title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-light border text-danger"
                            hx-get="@Url.Action("Delete", new { id = item.IdProducto })"
                            hx-target="#modal-content-generic" 
                            hx-swap="innerHTML" 
                            title="Eliminar">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
}