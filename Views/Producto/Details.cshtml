@model ProyectoSistemaInventarioNuevo.Models.VProducto
@{ 
    Layout = null; 
    var categoriasMap = ViewData["CategoriasMap"] as Dictionary<int, string>;
}

<div class="modal-header">
    <h5 class="modal-title">Detalles del Producto</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4">Producto</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>
        
        <dt class="col-sm-4">Categoría</dt>
        <dd class="col-sm-8">
             @(categoriasMap.ContainsKey(Model.IdCategoria) ? categoriasMap[Model.IdCategoria] : "N/A")
        </dd>

        <dt class="col-sm-4">Precio Compra</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioCompra)</dd>

        <dt class="col-sm-4">Precio Venta</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.PrecioVenta)</dd>

        <dt class="col-sm-4">Stock (Cantidad)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>
        
        <dt class="col-sm-4">Estado</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>