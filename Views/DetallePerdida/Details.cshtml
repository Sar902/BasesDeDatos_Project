@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum

<div class="modal-header">
    <h5 class="modal-title">Detalles del Detalle de Pérdida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4">Producto</dt>
        <dd class="col-sm-8">@Model.IdProductoNavigation?.Nombre</dd>

        <dt class="col-sm-4">Cantidad</dt>
        <dd class="col-sm-8">@Model.CantidadPerdida</dd>

        <dt class="col-sm-4">Precio Unitario</dt>
        <dd class="col-sm-8">@Model.PrecioCompraUnitario</dd>

        <dt class="col-sm-4">Subtotal</dt>
        <dd class="col-sm-8">@Model.SubtotalPerdida</dd>
    </dl>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>
