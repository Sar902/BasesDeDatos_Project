@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum

<div class="modal-header">
    <h5 class="modal-title">Detalles de la pérdida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-4 fw-bold">Producto:</dt>
        <dd class="col-sm-8">@(Model.IdProductoNavigation?.Nombre ?? "N/A")</dd>

        <dt class="col-sm-4 fw-bold">Fecha:</dt>
        <dd class="col-sm-8">@(Model.IdPerdidaNavigation?.Fecha.ToString("dd/MM/yyyy") ?? "N/A")</dd>

        <dt class="col-sm-4 fw-bold">Cantidad:</dt>
        <dd class="col-sm-8">@Model.CantidadPerdida</dd>

        <dt class="col-sm-4 fw-bold">Precio Unitario:</dt>
        <dd class="col-sm-8">@($"{Model.PrecioCompraUnitario:C}")</dd>

        <dt class="col-sm-4 fw-bold">Subtotal:</dt>
        <dd class="col-sm-8">@($"{Model.SubtotalPerdida:C}")</dd>
    </dl>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
</div>