@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.DetallePerdidum>

@foreach (var item in Model ?? Enumerable.Empty<ProyectoSistemaInventarioNuevo.Models.DetallePerdidum>())
{
    <tr>
        <td>@(item.IdProductoNavigation?.Nombre ?? "[Producto no asignado]")</td>
        <td>@(item.IdPerdidaNavigation != null ? item.IdPerdidaNavigation.Fecha.ToString("dd/MM/yyyy") : "[Fecha no asignada]")</td>
        <td>@item.CantidadPerdida</td>
        <td>@($"{item.PrecioCompraUnitario:N2}")</td>
        <td>@($"{item.SubtotalPerdida:N2}")</td>
        <td>
            <button class="btn btn-primary btn-sm"
                    hx-get="@Url.Action("Edit", new { id = item.IdDetallePerdida })"
                    hx-target="#modal-content-generic"
                    hx-swap="innerHTML">Edit</button>
            <button class="btn btn-info btn-sm"
                    hx-get="@Url.Action("Details", new { id = item.IdDetallePerdida })"
                    hx-target="#modal-content-generic"
                    hx-swap="innerHTML">Details</button>
            <button class="btn btn-danger btn-sm"
                    hx-get="@Url.Action("Delete", new { id = item.IdDetallePerdida })"
                    hx-target="#modal-content-generic"
                    hx-swap="innerHTML">Delete</button>
        </td>
    </tr>
}
