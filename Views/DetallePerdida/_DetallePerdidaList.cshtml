@model IEnumerable<ProyectoSistemaInventarioNuevo.ViewModels.PerdidaDetalleViewModel>

@{
    // Si tienes que acceder al IdPerdida, lo tomas del primer elemento del modelo.
    // Esto es solo para fines de ejemplo de URL.
    int idPerdida = Model.Any() ? Model.First().IdPerdida : 0; 
    decimal totalPerdida = Model.Sum(x => x.SubtotalPerdida);
}

@if (!Model.Any())
{
    <tr><td colspan="5" class="text-center">No hay productos registrados en esta pérdida.</td></tr>
}

@foreach (var item in Model)
{
    <tr id="detalle-perdida-@item.IdDetallePerdida"> 
        <td>@item.NombreProducto</td>
        <td class="text-center">@item.CantidadPerdida</td>
        <td class="text-end">@item.PrecioCompraUnitario.ToString("C")</td>
        <td class="text-end">@item.SubtotalPerdida.ToString("C")</td>
        <td class="text-center">
            <button class="btn btn-sm btn-info me-1"
                    hx-get="@Url.Action("Edit", "DetallePerdida", new { id = item.IdDetallePerdida })"
                    hx-target="#modal-content-generic"
                    data-bs-toggle="modal"
                    data-bs-target="#genericModal">
                <i class="bi bi-pencil"></i>
            </button>
            <button class="btn btn-sm btn-danger"
                    hx-get="@Url.Action("Delete", "DetallePerdida", new { id = item.IdDetallePerdida })"
                    hx-target="#modal-content-generic"
                    data-bs-toggle="modal"
                    data-bs-target="#genericModal">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const totalDisplay = document.getElementById('perdida-total-display');
        if (totalDisplay) {
            totalDisplay.innerText = '@totalPerdida.ToString("C")';
        }
    });
</script>