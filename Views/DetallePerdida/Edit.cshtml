@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum

<form hx-post="@Url.Action("Edit", new { id = Model.IdDetallePerdida })"
      hx-target="#modal-content-generic"
      hx-swap="innerHTML"
      class="needs-validation"
      novalidate>

    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">Editar Pérdida</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdDetallePerdida" />

        <div class="mb-2">
            <label>Fecha de Pérdida</label>
            <input type="date" class="form-control" name="fecha"
                   value="@(Model.IdPerdidaNavigation?.Fecha.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" readonly />
        </div>

        <div class="mb-2">
            <label>Producto</label>
            <select asp-for="IdProducto" class="form-control"
                    asp-items="@(new SelectList(ViewBag.Productos, "IdProducto", "Nombre", Model.IdProducto))">
            </select>
        </div>

        <div class="mb-2">
            <label asp-for="CantidadPerdida"></label>
            <input asp-for="CantidadPerdida" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="PrecioCompraUnitario"></label>
            <input asp-for="PrecioCompraUnitario" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="SubtotalPerdida"></label>
            <input asp-for="SubtotalPerdida" class="form-control" readonly />
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary"
                hx-on="htmx:afterRequest: htmx.trigger(window,'htmx:closeModal')">
            Guardar Cambios
        </button>
    </div>
</form>

@section Scripts {
<script>
(function() {
    const form = document.querySelector('#modal-content-generic form');
    if (!form) return;

    const cantidad = form.querySelector('input[name="CantidadPerdida"]');
    const precio = form.querySelector('input[name="PrecioCompraUnitario"]');
    const subtotal = form.querySelector('input[name="SubtotalPerdida"]');

    if (cantidad && precio && subtotal) {
        const calcularSubtotal = () => {
            subtotal.value = ((parseFloat(cantidad.value) || 0) * (parseFloat(precio.value) || 0)).toFixed(2);
        };
        cantidad.addEventListener('input', calcularSubtotal);
        precio.addEventListener('input', calcularSubtotal);
        calcularSubtotal();
    }
})();
</script>
@await Html.PartialAsync("_ValidationScriptsPartial")
}
