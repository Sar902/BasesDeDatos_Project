@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum
@{ Layout = null; }

<div class="modal-header">
    <h5 class="modal-title">Editar Pérdida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form asp-action="Edit"
          hx-post="@Url.Action("Edit", "DetallePerdida", new { id = Model.IdDetallePerdida })"
          hx-target="#modal-content-generic"
          hx-swap="innerHTML">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdDetallePerdida" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input type="text" class="form-control" value="@(Model.IdPerdidaNavigation?.Fecha.ToString("dd/MM/yyyy") ?? "-")" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="IdProducto" class="form-label">Producto</label>
            <select asp-for="IdProducto" class="form-select" asp-items="ViewBag.Productos"></select>
        </div>

        <div class="mb-3">
            <label asp-for="CantidadPerdida" class="form-label">Cantidad</label>
            <input asp-for="CantidadPerdida" type="number" class="form-control" min="1" />
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="submit" class="btn btn-primary"
        hx-on::after-request="htmx.trigger(document.body, 'refreshDetalleList'); bootstrap.Modal.getInstance(document.getElementById('genericModal')).hide();">
    Guardar Cambios
</button>
        </div>
    </form>
</div>
