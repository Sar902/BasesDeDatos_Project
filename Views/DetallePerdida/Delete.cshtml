@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum

<form hx-post="@Url.Action("Delete", new { id = Model.IdDetallePerdida })"
      hx-target="#modal-content-generic"
      hx-swap="innerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">Confirmar Eliminación</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <p>¿Está seguro de eliminar el detalle de pérdida del producto 
            <strong>@Model.IdProductoNavigation?.Nombre</strong>?
        </p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-danger"
        hx-on::after-request="htmx.trigger(document.body, 'refreshDetalleList'); bootstrap.Modal.getInstance(document.getElementById('genericModal')).hide();">
    Eliminar
</button>
    </div>
</form>
