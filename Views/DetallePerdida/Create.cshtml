@model ProyectoSistemaInventarioNuevo.Models.DetallePerdidum

<div id="modal-content-generic">
<form hx-post="@Url.Action("Create","DetallePerdida")" 
      hx-target="#modal-content-generic" 
      hx-swap="outerHTML">

    @Html.AntiForgeryToken()

    <div class="modal-header">
        <h5 class="modal-title">Crear Pérdida</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label asp-for="IdProducto">Producto</label>
            <select asp-for="IdProducto" class="form-control" asp-items="@(ViewBag.Productos)">
                <option value="">-- Seleccione --</option>
            </select>
        </div>

        <div class="mb-2">
            <label asp-for="CantidadPerdida">Cantidad pérdida</label>
            <input asp-for="CantidadPerdida" class="form-control" type="number"/>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
</form>

@await Html.PartialAsync("_ValidationScriptsPartial")
