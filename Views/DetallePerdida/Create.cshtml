@model ProyectoSistemaInventarioNuevo.ViewModels.PerdidaDetalleViewModel
@{ Layout = null; }

<div class="modal-header">
    <h5 class="modal-title">Registrar Nueva Pérdida</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form asp-action="Create"
          hx-post="@Url.Action("Create", "DetallePerdida")"
          hx-target="#modal-content-generic"
          hx-swap="innerHTML">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <!-- Mostramos el Motivo como texto, no como input del detalle -->
        <div class="mb-3">
            <label class="form-label">Motivo</label>
            <input type="text" class="form-control" value="@ViewBag.Motivo" readonly />
        </div>

        <div class="mb-3">
            <label asp-for="IdProducto" class="form-label">Producto</label>
            <select asp-for="IdProducto" class="form-select" id="productoSelect">
                <option value="">-- Seleccione --</option>
                @foreach (var p in ((IEnumerable<dynamic>)ViewBag.Productos).GroupBy(p => p.Key).Select(g => g.First()))
                {
                    <option value="@p.Key" data-cantidad="@p.CantidadDisponible">@p.Nombre</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="CantidadPerdida" class="form-label">Cantidad</label>
            <input asp-for="CantidadPerdida" type="number" class="form-control" min="1" id="cantidadInput" />
            <span asp-validation-for="CantidadPerdida" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
<script>
const selectProducto = document.getElementById('productoSelect');
const inputCantidad = document.getElementById('cantidadInput');

selectProducto.addEventListener('change', () => {
    const opt = selectProducto.selectedOptions[0];
    inputCantidad.max = opt ? opt.dataset.cantidad : 0;
    if (inputCantidad.value > inputCantidad.max) inputCantidad.value = inputCantidad.max;
});

// Inicial
if (selectProducto.value) {
    const opt = selectProducto.selectedOptions[0];
    inputCantidad.max = opt ? opt.dataset.cantidad : 0;
}
</script>
}
