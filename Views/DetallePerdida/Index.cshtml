@{
    ViewData["Title"] = "Pérdidas";
}

<h1>Pérdidas</h1>

<p>
    <button class="btn btn-primary"
            hx-get="@Url.Action("Create")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        Crear Nueva Pérdida
    </button>

    <button class="btn btn-secondary"
            hx-get="@Url.Action("Index", "Perdida")"
            hx-target="#modal-content-generic"
            hx-swap="innerHTML">
        Ver Pérdidas Generales
    </button>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Fecha</th>
            <th>Cantidad</th>
            <th>Precio Unitario</th>
            <th>Subtotal</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody id="detalleperdida-tbody"
           hx-get="@Url.Action("GetDetallePerdidaList")"
           hx-trigger="load, refreshDetallePerdidaList from:body"
           hx-swap="innerHTML">
        <tr><td colspan="6">Cargando...</td></tr>
    </tbody>
</table>

<div id="modal-generic" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" id="modal-content-generic"></div>
    </div>
</div>

@section Scripts {
<script>
document.body.addEventListener('htmx:afterSwap', (e) => {
    if (e.target.id === "modal-content-generic") {
        const modal = new bootstrap.Modal(document.getElementById('modal-generic'));
        modal.show();
    }
});
document.body.addEventListener('htmx:afterRequest', (e) => {
    if (e.detail.xhr.getResponseHeader("HX-Trigger")?.includes("htmx:closeModal")) {
        const modalEl = document.getElementById('modal-generic');
        const modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
    }
});
</script>
}
