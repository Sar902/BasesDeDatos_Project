@model IEnumerable<ProyectoSistemaInventarioNuevo.Models.Perdidum>

<h1>Pérdidas</h1>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Motivo</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var p in Model)
        {
            <tr>
                <td>@p.IdPerdida</td>
                <td>@p.Fecha.ToShortDateString()</td>
                <td>@p.Motivo</td>
                <td>@p.Total.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
